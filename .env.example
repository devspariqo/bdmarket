# BD Market — Environment Variables
#
# Copy this file to `.env` and fill in the three REQUIRED values:
#   cp .env.example .env
#
# NEVER commit the real `.env` — it is already in .gitignore.


# ═════════════════════════════════════════════════════════════
#  REQUIRED — the app will not run correctly without these
# ═════════════════════════════════════════════════════════════

# Database connection string (read by Prisma, lib/db.ts)
#
#   SQLite     — a VPS or shared host with a persistent writable disk
#   PostgreSQL — required for Vercel and other read-only / serverless hosts
#   MySQL      — MariaDB / MySQL
#
DATABASE_URL="file:./prod.db"
# DATABASE_URL="postgresql://user:password@host:5432/bdmarket?sslmode=require"
# DATABASE_URL="mysql://user:password@host:3306/bdmarket"

# Signs the admin and customer session cookies (lib/auth.ts).
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# IMPORTANT: if this is left unset the app falls back to a development
# secret that is published in this repository, which would let anyone
# forge an admin session. Always set it in production.
#
AUTH_SECRET="REPLACE-ME-WITH-A-UNIQUE-RANDOM-STRING"

# Public URL of the site, including the protocol (app/layout.tsx, lib/settings.ts).
# Used for canonical tags, Open Graph, the sitemap and the web app manifest.
#
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time, so changing this
#       requires a rebuild — restarting the server is not enough.
#
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"


# ═════════════════════════════════════════════════════════════
#  RECOMMENDED — where uploaded images are stored
# ═════════════════════════════════════════════════════════════
#
# Admin uploads (logos, product photos, brand marks, favicons) default to
# `public/uploads` inside the application folder.
#
# That is fine on a VPS that keeps its checkout between deploys, and wrong on a
# host that replaces the application folder each time. Hostinger Web Apps builds
# into `~/domains/{domain}/hbuilds/current/`, a symlink the deploy swaps for a
# fresh directory — so every uploaded image is deleted on the next push while the
# database still holds its path, and the whole site fills with broken images.
#
# Set this to a folder OUTSIDE the application and uploads survive redeploys.
# Nothing else changes: URLs stay `/uploads/<file>`, only the directory moves.
# Make sure the folder exists and is writable by the app.
#
# The admin Media Library shows a warning whenever uploads are landing somewhere
# a deploy will delete, so this is visible rather than silent.
#
# UPLOAD_DIR="/home/youruser/uploads"


# ═════════════════════════════════════════════════════════════
#  PAYMENT GATEWAY CREDENTIALS DO NOT GO HERE
# ═════════════════════════════════════════════════════════════
#
# bKash, Nagad, Rocket, SSLCommerz, card and COD credentials are stored in
# the database, in the `PaymentMethod.config` JSON column, and are edited at:
#
#     Admin  ->  Settings  ->  Payments
#
# Each gateway has a sandbox / live toggle, so start in sandbox mode and
# switch over once the integration is verified. Nothing here reads them
# from the environment.


# ═════════════════════════════════════════════════════════════
#  RESERVED — not read by the code yet
# ═════════════════════════════════════════════════════════════
#
# Nothing below is read from the environment. Each of these integrations is
# configured in the database through the admin panel, so credentials survive a
# redeploy and can be rotated without touching hPanel:
#
#     bKash / Nagad / SSLCommerz ...... Admin -> Settings -> Payments
#     Couriers ........................ Admin -> Settings -> Courier & Delivery
#     Email + SMTP .................... Admin -> Settings -> Email & SMTP
#     SMS gateway ..................... Admin -> Settings -> SMS Gateway
#
# Setting any of them here currently has no effect. They are kept only to
# document the intended shape of a production configuration. If you are
# deploying today, ignore this whole section.

# ── bKash ──
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# ── Nagad ──
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

# ── SSLCommerz (cards / mobile banking) ──
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# ── Couriers ──
# Live values: Admin -> Settings -> Courier & Delivery
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# ── Email / SMTP (order confirmations) ──
# Live values: Admin -> Settings -> Email & SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── SMS gateway (order notifications) ──
# Live values: Admin -> Settings -> SMS Gateway
SMS_API_KEY=""
SMS_SENDER_ID="BDMARKET"

# ── Site display name ──
# The live value comes from Admin -> Settings -> General (site_name).
NEXT_PUBLIC_SITE_NAME="BD Market"
