# BD Market — Production Environment Template
#
# Copy this file to `.env` on your server and fill in real values.
#   cp .env.example .env
#
# NEVER commit the real `.env` to version control.

# ─────────────────────────────────────────────────────────────
# Database  (REQUIRED)
# ─────────────────────────────────────────────────────────────
# SQLite — works on a VPS or shared host with a writable disk:
DATABASE_URL="file:./prod.db"

# PostgreSQL — REQUIRED for Vercel / read-only filesystems:
# DATABASE_URL="postgresql://user:password@host:5432/bdmarket?sslmode=require"

# MySQL / MariaDB:
# DATABASE_URL="mysql://user:password@host:3306/bdmarket"


# ─────────────────────────────────────────────────────────────
# Auth  (REQUIRED — change this!)
# ─────────────────────────────────────────────────────────────
# Signs admin and customer session cookies.
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="REPLACE-ME-WITH-A-UNIQUE-RANDOM-STRING"


# ─────────────────────────────────────────────────────────────
# Site  (REQUIRED)
# ─────────────────────────────────────────────────────────────
# Must be the full public URL including protocol. Used for canonical
# tags, Open Graph, the sitemap and the web app manifest.
# NOTE: NEXT_PUBLIC_* values are embedded at BUILD time —
#       changing them requires a rebuild, not just a restart.
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="BD Market"


# ─────────────────────────────────────────────────────────────
# Payment gateways (optional — leave blank to disable)
# ─────────────────────────────────────────────────────────────
# Start in SANDBOX mode. Live keys go in Admin → Settings → Payments.

# bKash
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# Nagad
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

# SSLCommerz (cards / mobile banking)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""


# ─────────────────────────────────────────────────────────────
# Couriers (optional)
# ─────────────────────────────────────────────────────────────
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""


# ─────────────────────────────────────────────────────────────
# Email / SMTP (optional) — order confirmation emails
# ─────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""


# ─────────────────────────────────────────────────────────────
# SMS (optional) — Bangladeshi gateway, order notifications
# ─────────────────────────────────────────────────────────────
SMS_API_KEY=""
SMS_SENDER_ID="BDMARKET"
